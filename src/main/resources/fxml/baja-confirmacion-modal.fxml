<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.gestorrh.escritorio.presentation.controller.BajaConfirmacionModalController"
      styleClass="modal-root"
      prefWidth="460.0"
      spacing="0.0">

    <!-- Header -->
    <HBox styleClass="modal-header" alignment="CENTER_LEFT">
        <Label fx:id="tituloLabel" styleClass="modal-titulo"/>
    </HBox>

    <!-- Contenido -->
    <VBox styleClass="modal-tab-content" spacing="16.0">

        <Label fx:id="mensajeLabel" wrapText="true"
               styleClass="modal-field-label"/>

        <!-- Panel fecha (solo visible en modo baja) -->
        <VBox fx:id="panelFecha" spacing="6.0">
            <Label fx:id="labelFecha" styleClass="modal-field-label"/>
            <DatePicker fx:id="datePicker" maxWidth="Infinity"
                        styleClass="modal-text-field"/>
        </VBox>

        <Label fx:id="errorLabel"
               styleClass="modal-error-label"
               wrapText="true"
               visible="false"
               managed="false"/>

    </VBox>

    <!-- Footer -->
    <HBox styleClass="modal-footer" alignment="CENTER_RIGHT" spacing="10.0">
        <Button fx:id="btnCancelar"
                styleClass="modal-btn-cancelar"
                onAction="#handleCancelar"/>
        <Button fx:id="btnConfirmar"
                styleClass="modal-btn-guardar"
                onAction="#handleConfirmar"/>
    </HBox>

</VBox>
