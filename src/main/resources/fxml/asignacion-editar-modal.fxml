<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.gestorrh.escritorio.presentation.controller.AsignacionEditarModalController"
      styleClass="modal-root"
      prefWidth="480.0"
      spacing="0.0">

    <HBox styleClass="modal-header" alignment="CENTER_LEFT">
        <Label fx:id="lblTitulo" styleClass="modal-titulo"/>
    </HBox>

    <VBox styleClass="modal-tab-content" spacing="16.0">

        <Label fx:id="lblError"
               styleClass="modal-error-label"
               wrapText="true"
               visible="false"
               managed="false"/>

        <VBox spacing="4.0">
            <Label fx:id="lblEmpleado" styleClass="modal-field-label"/>
            <ComboBox fx:id="comboEmpleado"
                      styleClass="modal-combo-box"
                      maxWidth="Infinity"/>
        </VBox>

        <VBox spacing="4.0">
            <Label fx:id="lblTurno" styleClass="modal-field-label"/>
            <ComboBox fx:id="comboTurno"
                      styleClass="modal-combo-box"
                      maxWidth="Infinity"/>
        </VBox>

        <VBox spacing="4.0">
            <Label fx:id="lblModalidad" styleClass="modal-field-label"/>
            <ComboBox fx:id="comboModalidad"
                      styleClass="modal-combo-box"
                      maxWidth="Infinity"/>
        </VBox>

        <VBox spacing="4.0">
            <Label fx:id="lblMotivoCambio" styleClass="modal-field-label"/>
            <TextArea fx:id="textMotivoCambio"
                      styleClass="modal-text-field"
                      prefRowCount="3"
                      wrapText="true"/>
            <Label fx:id="lblErrorMotivo"
                   styleClass="modal-field-error"
                   visible="false"
                   managed="false"/>
        </VBox>

    </VBox>

    <HBox styleClass="modal-footer" alignment="CENTER_RIGHT" spacing="10.0">
        <Button fx:id="btnCancelar"
                styleClass="modal-btn-cancelar"
                onAction="#handleCancelar"/>
        <Button fx:id="btnGuardar"
                styleClass="modal-btn-guardar"
                onAction="#handleGuardar"/>
    </HBox>

</VBox>
