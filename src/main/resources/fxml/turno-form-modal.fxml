<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.gestorrh.escritorio.presentation.controller.TurnoFormController"
      styleClass="modal-root"
      prefWidth="440.0"
      prefHeight="380.0"
      spacing="0.0">

    <HBox styleClass="modal-header" alignment="CENTER_LEFT">
        <Label fx:id="modalTituloLabel" styleClass="modal-titulo"/>
    </HBox>

    <VBox styleClass="modal-tab-content" spacing="16.0">

        <Label fx:id="errorLabel"
               styleClass="modal-error-label"
               wrapText="true"
               visible="false"
               managed="false"/>

        <VBox spacing="4.0">
            <Label fx:id="labelDescripcion" styleClass="modal-field-label"/>
            <TextField fx:id="fieldDescripcion" styleClass="modal-text-field"/>
            <Label fx:id="errorDescripcion"
                   styleClass="modal-field-error"
                   visible="false"
                   managed="false"/>
        </VBox>

        <HBox spacing="16.0">

            <VBox spacing="4.0" HBox.hgrow="ALWAYS">
                <Label fx:id="labelHoraInicio" styleClass="modal-field-label"/>
                <TextField fx:id="fieldHoraInicio" styleClass="modal-text-field"/>
                <Label fx:id="errorHoraInicio"
                       styleClass="modal-field-error"
                       visible="false"
                       managed="false"/>
            </VBox>

            <VBox spacing="4.0" HBox.hgrow="ALWAYS">
                <Label fx:id="labelHoraFin" styleClass="modal-field-label"/>
                <TextField fx:id="fieldHoraFin" styleClass="modal-text-field"/>
                <Label fx:id="errorHoraFin"
                       styleClass="modal-field-error"
                       visible="false"
                       managed="false"/>
            </VBox>

        </HBox>

        <Label fx:id="labelAvisoNocturno"
               styleClass="config-banner-info"
               wrapText="true"
               maxWidth="Infinity"/>

    </VBox>

    <HBox styleClass="modal-footer" alignment="CENTER_RIGHT" spacing="10.0">
        <Button fx:id="btnCancelar"
                styleClass="modal-btn-cancelar"
                onAction="#handleCancelar"/>
        <Button fx:id="btnGuardar"
                styleClass="modal-btn-guardar"
                onAction="#handleGuardar"/>
    </HBox>

</VBox>
