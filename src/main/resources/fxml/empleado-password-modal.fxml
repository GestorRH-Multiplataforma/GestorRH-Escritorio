<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.gestorrh.escritorio.presentation.controller.empleado.EmpleadoPasswordModalController"
      styleClass="password-modal-root"
      prefWidth="440.0"
      spacing="0.0">

    <!-- Header -->
    <VBox styleClass="password-modal-header" spacing="4.0">
        <Label fx:id="tituloLabel" styleClass="password-modal-titulo"/>
        <Label fx:id="subtituloLabel" styleClass="password-modal-subtitulo" wrapText="true"/>
    </VBox>

    <!-- Contenido -->
    <VBox spacing="20.0">
        <padding>
            <Insets top="24.0" right="24.0" bottom="24.0" left="24.0"/>
        </padding>

        <!-- Display de la contraseña -->
        <VBox styleClass="password-display-container" alignment="CENTER" spacing="12.0">
            <Label fx:id="passwordLabel" styleClass="password-display"/>
            <Button fx:id="btnCopiar"
                    styleClass="password-modal-btn-copiar"
                    onAction="#handleCopiar"/>
        </VBox>

        <!-- Aviso de uso único -->
        <Label fx:id="avisoLabel"
               styleClass="password-aviso"
               wrapText="true"
               maxWidth="Infinity"/>

        <!-- Botón cerrar -->
        <HBox alignment="CENTER">
            <Button fx:id="btnCerrar"
                    styleClass="password-modal-btn-cerrar"
                    onAction="#handleCerrar"/>
        </HBox>

    </VBox>

</VBox>
