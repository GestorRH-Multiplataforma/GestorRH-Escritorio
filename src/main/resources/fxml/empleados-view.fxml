<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.gestorrh.escritorio.presentation.controller.EmpleadosController"
      styleClass="empleados-content"
      spacing="16.0">

    <padding>
        <Insets top="28.0" right="28.0" bottom="28.0" left="28.0"/>
    </padding>

    <HBox styleClass="empleados-toolbar" spacing="12.0" alignment="CENTER_LEFT">
        <TextField fx:id="campoBusqueda"
                   styleClass="empleados-search-field"
                   HBox.hgrow="ALWAYS"/>
        <ChoiceBox fx:id="selectorFiltro"
                   styleClass="empleados-filtro"/>
        <Button fx:id="btnNuevoEmpleado"
                styleClass="empleados-btn-nuevo"
                onAction="#handleNuevoEmpleado"/>
    </HBox>

    <Label fx:id="labelError"
           styleClass="empleados-error-label"
           wrapText="true"
           visible="false"
           managed="false"/>

    <TableView fx:id="tablaEmpleados"
               styleClass="empleados-table"
               VBox.vgrow="ALWAYS">

        <columns>
            <TableColumn fx:id="colNombre"       prefWidth="200"/>
            <TableColumn fx:id="colEmail"        prefWidth="180"/>
            <TableColumn fx:id="colDepartamento" prefWidth="120"/>
            <TableColumn fx:id="colPuesto"       prefWidth="150"/>
            <TableColumn fx:id="colRol"          prefWidth="100"/>
            <TableColumn fx:id="colFechaBaja"    prefWidth="160"/>
            <TableColumn fx:id="colAcciones"     prefWidth="160"/>
        </columns>

        <placeholder>
            <Label text="No se encontraron empleados" styleClass="empleados-tabla-placeholder"/>
        </placeholder>

    </TableView>

    <HBox styleClass="empleados-footer" spacing="12.0" alignment="CENTER">
        <Button fx:id="btnAnterior" styleClass="empleados-btn-paginacion"/>
        <Label  fx:id="labelPaginacion" styleClass="empleados-paginacion-label"
                HBox.hgrow="ALWAYS"/>
        <Button fx:id="btnSiguiente" styleClass="empleados-btn-paginacion"/>
    </HBox>

    <StackPane VBox.vgrow="NEVER">
        <ProgressIndicator fx:id="indicadorCarga"
                           maxWidth="40.0"
                           maxHeight="40.0"
                           visible="false"
                           managed="false"/>
    </StackPane>

</VBox>