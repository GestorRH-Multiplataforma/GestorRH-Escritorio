<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.gestorrh.escritorio.presentation.controller.DashboardController"
      styleClass="dashboard-content"
      spacing="24.0">

    <padding>
        <Insets top="32.0" right="32.0" bottom="32.0" left="32.0"/>
    </padding>

    <VBox spacing="4.0">
        <Label fx:id="bienvenidaLabel"  styleClass="dashboard-saludo"/>
        <Label fx:id="subtituloLabel"   styleClass="dashboard-subtitulo"/>
    </VBox>

    <HBox spacing="20.0">
        <VBox styleClass="kpi-card">
            <Label fx:id="kpiEmpleadosActivosTitulo" styleClass="kpi-title"/>
            <Label fx:id="kpiEmpleadosActivosValor"  text="—" styleClass="kpi-value"/>
        </VBox>
        <VBox styleClass="kpi-card">
            <Label fx:id="kpiTrabajandoAhoraTitulo" styleClass="kpi-title"/>
            <Label fx:id="kpiTrabajandoAhoraValor"  text="—" styleClass="kpi-value"/>
        </VBox>
        <VBox styleClass="kpi-card">
            <Label fx:id="kpiAusenciasHoyTitulo" styleClass="kpi-title"/>
            <Label fx:id="kpiAusenciasHoyValor"  text="—" styleClass="kpi-value"/>
        </VBox>
    </HBox>

    <StackPane VBox.vgrow="ALWAYS" styleClass="content-placeholder">
        <Label fx:id="actividadRecienteLabel" styleClass="section-title"/>
    </StackPane>

</VBox>
