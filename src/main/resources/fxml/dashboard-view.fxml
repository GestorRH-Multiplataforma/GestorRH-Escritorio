<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.gestorrh.escritorio.presentation.controller.DashboardController"
            styleClass="dashboard-root">

    <left>
        <VBox styleClass="sidebar">
            <Label fx:id="appTitleLabel" styleClass="sidebar-title"/>

            <VBox styleClass="sidebar-menu" VBox.vgrow="ALWAYS">
                <Button fx:id="menuDashboardBtn" styleClass="sidebar-btn, sidebar-btn-active"
                        maxWidth="Infinity" onAction="#handleMenuDashboard"/>
                <Button fx:id="menuEmployeesBtn" styleClass="sidebar-btn"
                        maxWidth="Infinity" onAction="#handleMenuEmployees"/>
                <Button fx:id="menuShiftsBtn" styleClass="sidebar-btn"
                        maxWidth="Infinity" onAction="#handleMenuShifts"/>
                <Button fx:id="menuAbsencesBtn" styleClass="sidebar-btn"
                        maxWidth="Infinity" onAction="#handleMenuAbsences"/>
                <Button fx:id="menuReportsBtn" styleClass="sidebar-btn"
                        maxWidth="Infinity" onAction="#handleMenuReports"/>
                <Button fx:id="menuSettingsBtn" styleClass="sidebar-btn"
                        maxWidth="Infinity" onAction="#handleMenuSettings"/>
            </VBox>

            <Button fx:id="logoutBtn" styleClass="sidebar-btn, sidebar-btn-logout"
                    maxWidth="Infinity" onAction="#handleLogout"/>
        </VBox>
    </left>

    <center>
        <VBox styleClass="content-area">

            <HBox styleClass="content-header">
                <Label fx:id="welcomeLabel" styleClass="welcome-label"/>
                <Label fx:id="companyNameLabel" styleClass="company-name-label"/>
                <HBox HBox.hgrow="ALWAYS"/>
                <ComboBox fx:id="languageSelector" styleClass="language-selector"/>
            </HBox>

            <HBox styleClass="kpi-container" spacing="20">
                <VBox styleClass="kpi-card">
                    <Label fx:id="kpiActiveEmployeesLabel" styleClass="kpi-title"/>
                    <Label fx:id="kpiActiveEmployeesValue" text="—" styleClass="kpi-value"/>
                </VBox>
                <VBox styleClass="kpi-card">
                    <Label fx:id="kpiWorkingNowLabel" styleClass="kpi-title"/>
                    <Label fx:id="kpiWorkingNowValue" text="—" styleClass="kpi-value"/>
                </VBox>
                <VBox styleClass="kpi-card">
                    <Label fx:id="kpiAbsencesTodayLabel" styleClass="kpi-title"/>
                    <Label fx:id="kpiAbsencesTodayValue" text="—" styleClass="kpi-value"/>
                </VBox>
            </HBox>

            <StackPane VBox.vgrow="ALWAYS" styleClass="content-placeholder">
                <Label fx:id="recentActivityLabel" styleClass="section-title"/>
            </StackPane>

        </VBox>
    </center>

</BorderPane>
