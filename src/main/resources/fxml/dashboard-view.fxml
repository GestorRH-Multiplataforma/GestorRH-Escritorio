<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.gestorrh.escritorio.presentation.controller.DashboardController"
      styleClass="dashboard-content"
      spacing="24.0">

    <padding>
        <Insets top="28.0" right="28.0" bottom="28.0" left="28.0"/>
    </padding>

    <HBox alignment="CENTER_LEFT" spacing="12.0">
        <Label fx:id="subtituloLabel" styleClass="dashboard-subtitulo"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button fx:id="btnActualizar"
                styleClass="dashboard-btn-actualizar"
                onAction="#handleActualizar">
            <graphic>
                <HBox spacing="6.0" alignment="CENTER">
                    <FontIcon iconLiteral="mdi2r-refresh"
                              iconSize="15"
                              styleClass="kpi-icon--primary"/>
                    <Label fx:id="btnActualizarLabel" styleClass="dashboard-saludo"/>
                </HBox>
            </graphic>
        </Button>
    </HBox>

    <Label fx:id="errorLabel"
           styleClass="dashboard-error-label"
           wrapText="true"
           visible="false"
           managed="false"/>

    <StackPane>
        <HBox fx:id="kpiContainer" spacing="16.0">

            <VBox fx:id="cardTotalEmpleados" styleClass="kpi-card, kpi-card--primary" HBox.hgrow="ALWAYS">
                <HBox styleClass="kpi-card-header" alignment="CENTER_LEFT">
                    <StackPane styleClass="kpi-icon-container--primary" HBox.hgrow="NEVER">
                        <FontIcon iconLiteral="mdi2a-account-group"
                                  iconSize="16"
                                  styleClass="kpi-icon--primary"/>
                    </StackPane>
                    <Label fx:id="kpiTotalEmpleadosTitulo"
                           styleClass="kpi-title"
                           HBox.hgrow="ALWAYS">
                        <HBox.margin>
                            <Insets left="8.0"/>
                        </HBox.margin>
                    </Label>
                </HBox>
                <Label fx:id="kpiTotalEmpleadosValor" text="—" styleClass="kpi-value"/>
                <Region styleClass="kpi-separator" maxWidth="Infinity"/>
                <HBox spacing="4.0" alignment="CENTER_LEFT">
                    <FontIcon iconLiteral="mdi2i-information-outline"
                              iconSize="13"
                              styleClass="kpi-icon--primary"/>
                    <Label fx:id="kpiTotalEmpleadosSubtitulo" styleClass="kpi-subtitle"/>
                </HBox>
            </VBox>

            <VBox fx:id="cardPlanificadosHoy" styleClass="kpi-card, kpi-card--info" HBox.hgrow="ALWAYS">
                <HBox styleClass="kpi-card-header" alignment="CENTER_LEFT">
                    <StackPane styleClass="kpi-icon-container--info" HBox.hgrow="NEVER">
                        <FontIcon iconLiteral="mdi2c-calendar-check"
                                  iconSize="16"
                                  styleClass="kpi-icon--info"/>
                    </StackPane>
                    <Label fx:id="kpiPlanificadosHoyTitulo"
                           styleClass="kpi-title"
                           HBox.hgrow="ALWAYS">
                        <HBox.margin>
                            <Insets left="8.0"/>
                        </HBox.margin>
                    </Label>
                </HBox>
                <Label fx:id="kpiPlanificadosHoyValor" text="—" styleClass="kpi-value"/>
                <Region styleClass="kpi-separator" maxWidth="Infinity"/>
                <HBox spacing="4.0" alignment="CENTER_LEFT">
                    <FontIcon iconLiteral="mdi2i-information-outline"
                              iconSize="13"
                              styleClass="kpi-icon--info"/>
                    <Label fx:id="kpiPlanificadosHoySubtitulo" styleClass="kpi-subtitle"/>
                </HBox>
            </VBox>

            <VBox fx:id="cardAusentesHoy" styleClass="kpi-card, kpi-card--warning" HBox.hgrow="ALWAYS">
                <HBox styleClass="kpi-card-header" alignment="CENTER_LEFT">
                    <StackPane styleClass="kpi-icon-container--warning" HBox.hgrow="NEVER">
                        <FontIcon iconLiteral="mdi2a-account-off"
                                  iconSize="16"
                                  styleClass="kpi-icon--warning"/>
                    </StackPane>
                    <Label fx:id="kpiAusentesHoyTitulo"
                           styleClass="kpi-title"
                           HBox.hgrow="ALWAYS">
                        <HBox.margin>
                            <Insets left="8.0"/>
                        </HBox.margin>
                    </Label>
                </HBox>
                <Label fx:id="kpiAusentesHoyValor" text="—" styleClass="kpi-value"/>
                <Region styleClass="kpi-separator" maxWidth="Infinity"/>
                <HBox spacing="4.0" alignment="CENTER_LEFT">
                    <FontIcon iconLiteral="mdi2i-information-outline"
                              iconSize="13"
                              styleClass="kpi-icon--warning"/>
                    <Label fx:id="kpiAusentesHoySubtitulo" styleClass="kpi-subtitle"/>
                </HBox>
            </VBox>

        </HBox>

        <ProgressIndicator fx:id="indicadorCarga"
                           maxWidth="48.0"
                           maxHeight="48.0"
                           visible="false"
                           managed="false"/>
    </StackPane>

    <HBox spacing="16.0" VBox.vgrow="ALWAYS">

        <VBox VBox.vgrow="ALWAYS"
              styleClass="content-placeholder"
              spacing="12.0"
              HBox.hgrow="ALWAYS">
            <padding>
                <Insets top="20.0" right="20.0" bottom="20.0" left="20.0"/>
            </padding>
            <Label fx:id="actividadRecienteLabel" styleClass="section-title"/>
        </VBox>

        <VBox styleClass="content-placeholder"
              spacing="12.0"
              minWidth="300.0"
              maxWidth="340.0"
              VBox.vgrow="NEVER">
            <padding>
                <Insets top="20.0" right="20.0" bottom="20.0" left="20.0"/>
            </padding>

            <Label fx:id="lblTopRetrasosTitulo" styleClass="section-title"/>

            <Separator/>

            <StackPane VBox.vgrow="NEVER">
                <ProgressIndicator fx:id="indicadorTopRetrasos"
                                   maxWidth="32.0"
                                   maxHeight="32.0"
                                   visible="false"
                                   managed="false"/>
            </StackPane>

            <TableView fx:id="tablaTopRetrasos"
                       styleClass="empleados-table"
                       VBox.vgrow="NEVER">
                <columns>
                    <TableColumn fx:id="colPosicion" prefWidth="40.0" maxWidth="40.0"/>
                    <TableColumn fx:id="colEmpleado" prefWidth="160.0"/>
                    <TableColumn fx:id="colTotal"    prefWidth="90.0"/>
                </columns>
                <placeholder>
                    <Label styleClass="empleados-tabla-placeholder"/>
                </placeholder>
            </TableView>

            <Label fx:id="lblTopRetrasosVacio"
                   styleClass="empleados-tabla-placeholder"
                   wrapText="true"
                   visible="false"
                   managed="false"/>

        </VBox>

    </HBox>

</VBox>
